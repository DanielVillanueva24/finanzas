# Copia este archivo como .env dentro de backend/ y ajusta los valores.

# Base de datos (SQLite por defecto, no requiere servidor)
DATABASE_URL=sqlite:///./finanzas.db

# Llave para firmar los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-llave-en-produccion-por-una-aleatoria-larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Crear el usuario demo al arrancar (ponlo en false en produccion)
SEED_DEMO_DATA=true
